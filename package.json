{
  "name": "claude-cost",
  "version": "0.10.2",
  "private": true,
  "description": "Approximate local cost tracking for Claude Code by parsing session transcripts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "claude-cost": "dist/bin/claude-cost.js"
  },
  "files": [
    "!dist/**/*.map",
    "dist/bin",
    "dist/src",
    "pricing.config.json",
    "profiles.config.example.json",
    "README.md",
    "settings.config.example.json"
  ],
  "scripts": {
    "build": "node scripts/clean.ts && tsc -p tsconfig.build.json && tsc -p src/dashboard/tsconfig.build.json && node scripts/build.ts",
    "dashboard": "node bin/claude-cost.ts --dashboard",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "history": "node bin/claude-cost.ts --by-month",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "oxlint --type-aware",
    "monthly": "node bin/claude-cost.ts --monthly --by-model",
    "prepare": "npm run build",
    "smoke": "npm run build && node scripts/smoke.ts",
    "start": "node bin/claude-cost.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/dashboard/tsconfig.json"
  },
  "keywords": [
    "claude-code",
    "claude",
    "cli",
    "cost",
    "tokens",
    "vertex-ai"
  ],
  "author": "Mykhailo Zeleniuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzeleniuk/ClaudeCost.git"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
