{
  "name": "claude-cost",
  "version": "0.9.3",
  "private": true,
  "description": "Approximate local cost tracking for Claude Code by parsing session transcripts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "claude-cost": "bin/claude-cost.js"
  },
  "files": [
    "bin",
    "pricing.config.json",
    "profiles.config.example.json",
    "README.md",
    "settings.config.example.json",
    "src"
  ],
  "scripts": {
    "dashboard": "node bin/claude-cost.js --dashboard",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "history": "node bin/claude-cost.js --by-month",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "for f in bin/*.js src/*.js src/dashboard/*.js src/report/*.js; do node --check \"$f\"; done",
    "monthly": "node bin/claude-cost.js --monthly --by-model",
    "start": "node bin/claude-cost.js",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json"
  },
  "keywords": [
    "claude-code",
    "claude",
    "cli",
    "cost",
    "tokens",
    "vertex-ai"
  ],
  "author": "Mykhailo Zeleniuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzeleniuk/ClaudeCost.git"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
