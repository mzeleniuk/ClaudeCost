{
  "name": "claude-cost",
  "version": "0.8.0",
  "private": true,
  "description": "Approximate local cost tracking for Claude Code (Vertex AI) by parsing session transcripts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "claude-cost": "bin/claude-cost.js"
  },
  "files": [
    "bin",
    "pricing.config.json",
    "profiles.config.example.json",
    "README.md",
    "settings.config.example.json",
    "src"
  ],
  "scripts": {
    "history": "node bin/claude-cost.js --by-month",
    "lint": "for f in bin/*.js src/*.js src/report/*.js; do node --check \"$f\"; done",
    "monthly": "node bin/claude-cost.js --monthly --by-model",
    "start": "node bin/claude-cost.js",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json"
  },
  "keywords": [
    "claude-code",
    "claude",
    "cli",
    "cost",
    "tokens",
    "vertex-ai"
  ],
  "author": "Mykhailo Zeleniuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzeleniuk/ClaudeCost.git"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
