#!/bin/sh
# Checks formatting of staged files, types of the TypeScript sources and lint.

set -e

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -n "$staged" ]; then
  echo "pre-commit: checking formatting of staged files"
  echo "$staged" | tr '\n' '\0' | xargs -0 npx --no-install prettier --check --ignore-unknown
fi

echo "pre-commit: running typecheck"
npm run --silent typecheck

echo "pre-commit: running lint"
npm run --silent lint
